# ─── Flutter / Dart ────────────────────────────────────────────────────────────
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub-cache/
app/.pub/
app/build/
app/.metadata

# Dart code generated by build_runner (drift ORM, json_serializable)
# After cloning: cd app && dart run build_runner build
app/**/*.g.dart
app/**/*.freezed.dart

# ─── PlatformIO ────────────────────────────────────────────────────────────────
# Build artefacts and downloaded libraries (can be hundreds of MB)
firmware/.pio/
# Contains absolute machine-specific paths; regenerate: cd firmware && pio run --target compiledb
firmware/compile_commands.json
# Python venv — regenerate: cd firmware && python -m venv .venv && pip install -r requirements.txt
firmware/.venv/

# ─── KiCad ─────────────────────────────────────────────────────────────────────
hardware/**/*.kicad_pcb-bak
hardware/**/*.kicad_sch-bak
hardware/**/*.bak
hardware/**/*-backups/
hardware/**/_autosave-*
hardware/**/fp-info-cache
# Per-user project-local settings (last view, grid, etc.) — not shared
hardware/**/*.kicad_prl

# ─── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ─── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
# VS Code workspace settings are optional to share.
# Uncomment the line below if the team decides not to commit them:
# .vscode/

# ─── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ─── Logs / temp ───────────────────────────────────────────────────────────────
*.log
*.tmp

# ─── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
*.secret
