# Строка подключения к PostgreSQL (обязательно)
DATABASE_URL=postgres://himo:himo@localhost:5432/himo

# Адрес, на котором слушает сервер
HUB_ADDR=:8080

# Адрес сервиса; с ним сравнивается заголовок Origin (обязательно)
PUBLIC_URL=http://localhost:8080

# Токен бота Telegram Login Widget; без него вход и привязка Telegram отклоняются
TELEGRAM_BOT_TOKEN=

# Минимальная версия приложения; пусто — без проверки
MIN_APP_VERSION=

# Адреса и подсети через запятую, от которых принимается X-Forwarded-For; пусто — ни от кого
TRUSTED_PROXIES=

# Лимиты тарифов в JSON; тариф free обязателен
PLANS={"free": {"max_members": 5}}
